# --- anyfileqt ---------------------------------------------------------------
# Build output. A CMake cache records the absolute path it was created at and
# cannot be relocated, so build directories never belong in the tree; the
# bundle scripts wipe one that gets through anyway.
build/
build-*/
dist/
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
CTestTestfile.cmake
compile_commands.json
Makefile
.qt/

# Editors and OS litter
.vscode/
.idea/
*.swp
.DS_Store

